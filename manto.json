{
  "base_url": "",
  "description": "Manto is a local-first Markdown CMS. Your content lives as plain .md files, with no database. Edit in a split-pane editor, export a static site, or ship a self-contained release.",
  "fabric": {
    "active": "dark",
    "themes": {
      "curitiba": {
        "colors": {
          "accent": {
            "background": "#003cff",
            "text": "#eeff00"
          },
          "primary": {
            "background": "#706a4c",
            "text": "#ffffff"
          },
          "secondary": {
            "background": "#6d737e",
            "text": "#006aff"
          }
        },
        "custom_css": "",
        "layout": {
          "content_radius": "0.375rem",
          "page_width": "40rem"
        },
        "typography": {
          "font_body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "font_code": "ui-monospace, monospace",
          "font_heading": "inherit"
        }
      },
      "purple coffee": {
        "colors": {
          "accent": {
            "background": "#fef3c7",
            "text": "#d4a574"
          },
          "primary": {
            "background": "#6b21a8",
            "text": "#000000"
          },
          "secondary": {
            "background": "#e9d5ff",
            "text": "#4b5563"
          }
        },
        "custom_css": "",
        "layout": {
          "content_radius": "0.375rem",
          "page_width": "42rem"
        },
        "typography": {
          "font_body": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "font_code": "ui-monospace, monospace",
          "font_heading": "inherit"
        }
      }
    }
  },
  "plugins": [
    "toc",
    "header_image"
  ],
  "title": "Manto",
  "vault_path": "pages"
}

<Layouts.flash_group flash={@flash} />

<main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 sm:py-16">
  <header>
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Settings</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Point Manto at your vault and customize your site.
    </p>
  </header>

  <section
    id="vault-summary"
    class="mt-8 rounded-box border border-base-300 bg-base-100 p-4"
  >
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
      Vault
    </h2>
    <dl class="mt-3 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div class="min-w-0">
        <dt class="text-gray-500 dark:text-gray-400">Configured path</dt>
        <dd
          class="mt-0.5 font-medium font-mono overflow-x-auto whitespace-nowrap"
          title={@vault_path}
        >
          {@vault_path}
        </dd>
      </div>
      <div class="min-w-0">
        <dt class="text-gray-500 dark:text-gray-400">Resolved to</dt>
        <dd
          class="mt-0.5 font-medium font-mono overflow-x-auto whitespace-nowrap"
          title={@vault_abs_path}
        >
          {@vault_abs_path}
        </dd>
      </div>
      <div>
        <dt class="text-gray-500 dark:text-gray-400">Pages</dt>
        <dd class="mt-0.5 font-medium">{@page_count}</dd>
      </div>
    </dl>
  </section>

  <form id="settings-form" phx-submit="save" class="mt-8 space-y-6">
    <div>
      <label for="vault_path" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Vault path
      </label>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Folder containing your Markdown pages. Relative to the project root, or
        absolute (a leading <code class="font-mono">~/</code> is expanded to
        your home directory).
      </p>
      <input
        id="vault_path"
        type="text"
        name="vault_path"
        value={@vault_path}
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <div>
      <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Site title
      </label>
      <input
        id="title"
        type="text"
        name="title"
        value={@title}
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Description
      </label>
      <textarea
        id="description"
        name="description"
        rows="3"
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      >{@description}</textarea>
    </div>

    <div>
      <label for="base_url" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Base URL
      </label>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Used when building the static site, e.g. <code class="font-mono">https://example.com</code>.
      </p>
      <input
        id="base_url"
        type="text"
        name="base_url"
        value={@base_url}
        placeholder="https://example.com"
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <section
      id="plugins-section"
      class="rounded-box border border-base-300 bg-base-100 p-4"
    >
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
        Plugins
      </h2>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Enable or disable content transformation plugins.
      </p>
      <div class="mt-3 space-y-2">
        <input type="hidden" name="plugins[]" value="" />
        <%= for {name, _mod, label} <- @available_plugins do %>
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="checkbox"
              name="plugins[]"
              value={name}
              checked={name in @plugins}
              class="checkbox checkbox-sm"
            />
            <span class="text-sm text-gray-700 dark:text-gray-200">{label}</span>
          </label>
        <% end %>
      </div>
    </section>

    <section
      id="theme-section"
      class="rounded-box border border-base-300 bg-base-100 p-4"
    >
      <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
        Theme
      </h2>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Choose the active theme for the static site and editor preview.
      </p>
      <div class="mt-3">
        <select
          id="theme"
          name="theme"
          class="w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
        >
          <option disabled>────────── Built-in ──────────</option>
          <%= for theme <- @available_themes |> Enum.filter(&(&1.type == :builtin)) do %>
            <option value={theme.name} selected={theme.name == @active_theme}>
              {theme.name}
            </option>
          <% end %>
          <option disabled>────────── Custom ──────────</option>
          <%= for theme <- @available_themes |> Enum.filter(&(&1.type == :custom)) do %>
            <option value={theme.name} selected={theme.name == @active_theme}>
              {theme.name}
            </option>
          <% end %>
        </select>
        <button
          type="button"
          phx-click="toggle-theme-builder"
          class="mt-3 px-3 py-1.5 text-xs bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-md hover:bg-gray-300 dark:hover:bg-gray-600"
        >
          {(@show_theme_builder && "Hide") || "Manage"} themes
        </button>
      </div>
    </section>

    <%= if @show_theme_builder do %>
      <section
        id="theme-builder"
        class="rounded-box border border-base-300 bg-base-100 p-4 space-y-4"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
            {if @editing_theme, do: "Edit: #{@editing_theme}", else: "New theme"}
          </h2>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="new-theme"
              class="px-2 py-1 text-xs bg-indigo-100 dark:bg-indigo-900 text-indigo-700 dark:text-indigo-200 rounded hover:bg-indigo-200 dark:hover:bg-indigo-800"
            >
              + New
            </button>
            <button
              type="button"
              phx-click="duplicate-theme"
              class="px-2 py-1 text-xs bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded hover:bg-gray-300 dark:hover:bg-gray-600"
            >
              Duplicate
            </button>
            <button
              type="button"
              phx-click="delete-theme"
              class="px-2 py-1 text-xs bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-200 rounded hover:bg-red-200 dark:hover:bg-red-800"
            >
              Delete
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Theme name
            </label>
            <input
              type="text"
              id="builder-name"
              phx-keyup="builder-change"
              phx-debounce="300"
              value={@builder_name}
              placeholder="my-theme"
              class="w-full px-2 py-1.5 text-sm border rounded bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Content width
            </label>
            <input
              type="text"
              id="builder-content-width"
              phx-keyup="builder-change"
              phx-debounce="300"
              value={@builder_layout[:content_width]}
              placeholder="42rem"
              class="w-full px-2 py-1.5 text-sm border rounded bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Content radius
            </label>
            <input
              type="text"
              id="builder-content-radius"
              phx-keyup="builder-change"
              phx-debounce="300"
              value={@builder_layout[:content_radius]}
              placeholder="0.375rem"
              class="w-full px-2 py-1.5 text-sm border rounded bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Font body
            </label>
            <input
              type="text"
              id="builder-font-body"
              phx-keyup="builder-change"
              phx-debounce="300"
              value={@builder_typography[:font_body]}
              placeholder="-apple-system, sans-serif"
              class="w-full px-2 py-1.5 text-sm border rounded bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Font code
            </label>
            <input
              type="text"
              id="builder-font-code"
              phx-keyup="builder-change"
              phx-debounce="300"
              value={@builder_typography[:font_code]}
              placeholder="ui-monospace, monospace"
              class="w-full px-2 py-1.5 text-sm border rounded bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Text color
            </label>
            <input
              type="color"
              id="builder-color-text"
              phx-change="builder-change"
              value={@builder_colors[:text]}
              class="w-full h-9 rounded cursor-pointer"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Background
            </label>
            <input
              type="color"
              id="builder-color-bg"
              phx-change="builder-change"
              value={@builder_colors[:background]}
              class="w-full h-9 rounded cursor-pointer"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Link color
            </label>
            <input
              type="color"
              id="builder-color-link"
              phx-change="builder-change"
              value={@builder_colors[:link]}
              class="w-full h-9 rounded cursor-pointer"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-600 dark:text-gray-300 mb-1">
              Code background
            </label>
            <input
              type="color"
              id="builder-color-pre-bg"
              phx-change="builder-change"
              value={@builder_colors[:pre_background]}
              class="w-full h-9 rounded cursor-pointer"
            />
          </div>
        </div>

        <div class="flex items-center gap-2 pt-2 border-t border-base-300">
          <button
            type="button"
            phx-click="save-theme"
            class="px-4 py-1.5 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
          >
            Save theme
          </button>
          <span class="text-xs text-gray-500 dark:text-gray-400">
            <%= if @builder_flash do %>
              {@builder_flash}
            <% end %>
          </span>
        </div>
      </section>
    <% end %>

    <div class="flex items-center gap-3">
      <button
        type="submit"
        class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
      >
        Save settings
      </button>
      <.link
        navigate={~p"/editor"}
        class="px-4 py-2 text-sm bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-md hover:bg-gray-300 dark:hover:bg-gray-600"
      >
        Open editor
      </.link>
    </div>
  </form>

  <p class="mt-8 text-xs text-gray-500 dark:text-gray-400">
    Settings are stored in <code class="font-mono">manto.json</code> in the
    project root and also drive <code class="font-mono">mix manto.build</code>.
  </p>
</main>

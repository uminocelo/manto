<Layouts.flash_group flash={@flash} />

<main class="mx-auto max-w-2xl px-4 py-10 sm:px-6 sm:py-16">
  <header>
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Settings</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Point Manto at your vault and customize your site.
    </p>
  </header>

  <section
    id="vault-summary"
    class="mt-8 rounded-box border border-base-300 bg-base-100 p-4"
  >
    <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
      Vault
    </h2>
    <dl class="mt-3 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
      <div class="min-w-0">
        <dt class="text-gray-500 dark:text-gray-400">Configured path</dt>
        <dd
          class="mt-0.5 font-medium font-mono overflow-x-auto whitespace-nowrap"
          title={@vault_path}
        >
          {@vault_path}
        </dd>
      </div>
      <div class="min-w-0">
        <dt class="text-gray-500 dark:text-gray-400">Resolved to</dt>
        <dd
          class="mt-0.5 font-medium font-mono overflow-x-auto whitespace-nowrap"
          title={@vault_abs_path}
        >
          {@vault_abs_path}
        </dd>
      </div>
      <div>
        <dt class="text-gray-500 dark:text-gray-400">Pages</dt>
        <dd class="mt-0.5 font-medium">{@page_count}</dd>
      </div>
    </dl>
  </section>

  <form id="settings-form" phx-submit="save" class="mt-8 space-y-6">
    <div>
      <label for="vault_path" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Vault path
      </label>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Folder containing your Markdown pages. Relative to the project root, or
        absolute (a leading <code class="font-mono">~</code> is expanded to your
        home directory).
      </p>
      <input
        id="vault_path"
        type="text"
        name="vault_path"
        value={@vault_path}
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <div>
      <label for="title" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Site title
      </label>
      <input
        id="title"
        type="text"
        name="title"
        value={@title}
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Description
      </label>
      <textarea
        id="description"
        name="description"
        rows="3"
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      >{@description}</textarea>
    </div>

    <div>
      <label for="base_url" class="block text-sm font-medium text-gray-700 dark:text-gray-200">
        Base URL
      </label>
      <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
        Used when building the static site, e.g. <code class="font-mono">https://example.com</code>.
      </p>
      <input
        id="base_url"
        type="text"
        name="base_url"
        value={@base_url}
        placeholder="https://example.com"
        class="mt-2 w-full px-3 py-2 text-sm border rounded-md bg-gray-50 dark:bg-gray-900 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
      />
    </div>

    <div class="flex items-center gap-3">
      <button
        type="submit"
        class="px-4 py-2 text-sm bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
      >
        Save settings
      </button>
      <.link
        navigate={~p"/editor"}
        class="px-4 py-2 text-sm bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 rounded-md hover:bg-gray-300 dark:hover:bg-gray-600"
      >
        Open editor
      </.link>
    </div>
  </form>

  <p class="mt-8 text-xs text-gray-500 dark:text-gray-400">
    Settings are stored in <code class="font-mono">manto.json</code> in the
    project root and also drive <code class="font-mono">mix manto.build</code>.
  </p>
</main>
